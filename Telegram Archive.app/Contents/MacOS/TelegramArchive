#!/bin/sh
# Launcher inside the .app bundle.
#
# The bundle sits *in* the program folder, so the program is three levels up
# from Contents/MacOS/. Resolving it from $0 keeps the app working wherever
# the folder is moved to.
HERE="$(cd "$(dirname "$0")/../../.." && pwd)" || exit 1
cd "$HERE" || exit 1

mkdir -p "$HERE/data/logs" 2>/dev/null
exec >>"$HERE/data/launch.log" 2>&1

# Log before anything else can fail. Everything below this line -- finding
# Python, reading our own folder, starting the server -- has failed on someone
# else's Mac at least once, and each of those used to leave nothing behind to
# read. Written by hand rather than by the Python logger, because at this point
# we do not yet know that Python exists.
SESSION="$(date -u +%s)-$$"
export TG_SESSION="$SESSION"
LOGFILE="$HERE/data/logs/archive.jsonl"
note() {
  printf '{"t":"%s","level":"%s","src":"launcher","pid":%s,"session":"%s","event":"%s"%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%S.000+00:00)" "$2" "$$" "$SESSION" "$1" "$3" \
    >>"$LOGFILE" 2>/dev/null
}

note "launcher.start" "info" ",\"here\":\"$HERE\""

# A GUI launch gets a minimal PATH that often lacks /usr/local/bin and
# /opt/homebrew/bin, so check the usual homes rather than trusting PATH.
for candidate in /usr/bin/python3 /usr/local/bin/python3 \
                 /opt/homebrew/bin/python3 "$(command -v python3 2>/dev/null)"; do
  if [ -x "$candidate" ]; then PY="$candidate"; break; fi
done
if [ -z "$PY" ]; then
  note "launcher.no_python" "error" ""
  osascript -e 'display alert "Python 3 is required" message "Install Python 3 from python.org, then open Telegram Archive again."'
  exit 1
fi
note "launcher.python" "info" ",\"path\":\"$PY\""

# macOS blocks apps from reading ~/Documents, ~/Desktop and ~/Downloads unless
# they have been granted access, and for an unsigned app it denies silently
# rather than prompting. Detect that here instead of dying with a bare
# "Operation not permitted" nobody can act on.
if ! head -c 1 serve.py >/dev/null 2>&1; then
  note "launcher.own_folder_unreadable" "error" ",\"here\":\"$HERE\""
  osascript -e 'display alert "Telegram Archive cannot read its own folder" message "macOS protects Documents, Desktop and Downloads. Move the Telegram Archive folder somewhere else — your Home folder or Applications works — and open it again.\n\nAlternatively, grant it Full Disk Access in System Settings › Privacy & Security." as critical'
  exit 1
fi

# Touch the backup folder once, up front. This is what makes macOS show its
# "would like to access" prompt -- and it has to happen here, in the app's own
# process, at launch. Buried in the indexer it would either be missed or asked
# at a baffling moment. A refusal is explained rather than left to surface as
# "Operation not permitted" three layers down.
"$PY" -m tools.access
case $? in
  2)
    note "launcher.backup_folder_denied" "warn" ""
    REASON=$("$PY" -m tools.access 2>&1 >/dev/null)
    osascript -e "display alert \"Telegram Archive cannot read your backup folder\" message \"$(printf '%s' "$REASON" | sed 's/["\\]/\\&/g')\" as critical" >/dev/null 2>&1
    # Not fatal: the server still runs, so the folder can be repointed in
    # Settings rather than leaving someone with a window that never opens.
    ;;
esac

# The server comes up FIRST and indexes afterwards, in the background.
# Indexing here used to block the launch: a big archive meant several minutes
# of a bouncing dock icon and no window, which reads as a hang -- and the
# reasonable response to that is to double-click the app again, which used to
# start a second copy. Now the window opens immediately and shows progress.
note "launcher.starting_server" "info" ""
exec "$PY" serve.py --index-on-start
